NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=5173
PREVIEW_HOST=127.0.0.1
PREVIEW_BASE_PORT=4300
# Runtime preview: "live" (local vite dev server, fast iteration) or "static"
# (built dist served through the authed API — no raw ports; the hosted default).
# Defaults to static when NODE_ENV=production, live otherwise.
PREVIEW_MODE=
PREVIEW_MAX_CONCURRENT=4
PREVIEW_IDLE_TIMEOUT_MS=300000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_AGENT_ENABLED=false
ANTHROPIC_API_KEY=
# AI_SCENE_PROVIDER overrides the Settings-UI choice: claude | openai | gemini | auto
AI_SCENE_PROVIDER=auto
# --- Accounts / Supabase ---
# Leave SUPABASE_URL or SUPABASE_DB_URL blank to run single-tenant (no login).
# Set BOTH to enable multi-tenant accounts (JWT auth + Postgres-backed projects).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string).
SUPABASE_DB_URL=
# Optional: legacy HS256 JWT secret (older projects). New projects verify via JWKS.
SUPABASE_JWT_SECRET=
# Optional: owner id assigned to projects in single-tenant mode.
LOCAL_OWNER_ID=local-owner
# Required when accounts are enabled: encrypts per-user provider keys at rest.
# Use a long random string (e.g. `openssl rand -hex 32`).
SETTINGS_ENC_KEY=
# When true, users without their own provider key fall back to the platform keys
# above (otherwise BYO-only). Leave false for a public launch until quotas exist.
ALLOW_PLATFORM_KEYS=false
# Per-user daily quotas (multi-tenant only; <=0 = unlimited). Protect server
# resources for BYO users; lower these if you enable platform/test tokens.
QUOTA_AGENT_RUNS_PER_DAY=100
QUOTA_BUILDS_PER_DAY=200
# Web (Vite) — exposed to the browser; the anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
STUDIO_WORKSPACE_ROOT=.studio/projects
STUDIO_ASSET_ROOT=.studio/assets
STUDIO_SNAPSHOT_ROOT=.studio/snapshots
STUDIO_RAG_INDEX=.studio/rag-index.json
